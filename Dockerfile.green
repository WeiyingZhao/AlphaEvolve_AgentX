# Dockerfile for Green Agent (Evaluator)
# This container runs the evaluation environment and scoring engine

FROM python:3.11-slim

LABEL maintainer="AlphaEvolve Team"
LABEL description="Green Agent - Evaluator for Software Engineering Benchmarks"
LABEL version="0.1.0"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash agent
WORKDIR /app

# Copy requirements first for better caching
COPY pyproject.toml ./
COPY src/ ./src/

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install -e . && \
    pip install pandas scikit-learn numpy matplotlib

# Create persistent workspace
RUN mkdir -p /workspace && \
    chown agent:agent /workspace && \
    chmod 777 /workspace

# Set volume for persistence
VOLUME /workspace

# Copy benchmark tasks
COPY benchmarks/ ./benchmarks/

# Copy configuration files
COPY config/ ./config/

# Change ownership to root for security (readonly code)
RUN chown -R root:root /app

# Create a restricted working directory for execution
RUN mkdir -p /tmp/agent_work && \
    chown -R agent:agent /tmp/agent_work && \
    chmod 700 /tmp/agent_work

# Ensure Python's tempfile module uses our restricted dir
ENV TMPDIR=/tmp/agent_work

# Switch to non-root user
USER agent

# Expose the Green Agent port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the Green Agent server
CMD ["python", "-m", "agentx.green_agent.server"]
